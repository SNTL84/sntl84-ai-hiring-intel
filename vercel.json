{
  "version": 2,
  "builds": [
    { "src": "api/evaluate.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static", "config": { "excludeFiles": ["api/**"] } }
  ],
  "routes": [
    { "src": "/api/evaluate", "dest": "/api/evaluate.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}